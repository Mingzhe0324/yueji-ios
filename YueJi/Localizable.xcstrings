          }
        }
      }
    },
    "交易时间": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction date"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarikh transaksi"
          }
        }
      }
    },
    "交易标识（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction ID (optional)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "ID transaksi (pilihan)"
          }
        }
      }
    },
    "将快捷指令提供的成功付款写入月记本地账本。不会读取银行或钱包历史记录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a successful payment from Shortcuts locally. Does not read bank or Wallet history."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan bayaran berjaya daripada Pintasan secara tempatan. Tidak membaca sejarah bank atau Wallet."
          }
        }
      }
    },
    "已保存到月记。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to YueJi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan ke YueJi."
          }
        }
      }
    },
    "这笔付款已记录，没有重复入账。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already recorded. No duplicate added."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah direkod. Tiada pendua ditambah."
          }
        }
      }
    },
    "补记固定消费": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post recurring expenses"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod belanja berulang"
          }
        }
      }
    },
    "补记已到期且开启自动入账的固定消费，不会执行付款。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record due schedules with auto-recording enabled. Does not make payments."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod jadual yang tiba dengan rekod automatik diaktifkan. Tidak membuat bayaran."
          }
        }
      }
    },
    "已检查到期项目。缺少汇率的项目仍保留待记。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked due schedules. Entries without rates remain pending."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadual yang tiba telah disemak. Rekod tanpa kadar masih tertunda."
          }
        }
      }
    },
    "记录 TNG 通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record TNG notification"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod notifikasi TNG"
          }
        }
      }
    },
    "记录 TNG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record TNG"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod TNG"
          }
        }
      }
    },
    "通知正文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification body"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks notifikasi"
          }
        }
      }
    },
    "通知标题（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification title (optional)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk notifikasi (pilihan)"
          }
        }
      }
    },
    "通知时间（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification date (optional)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarikh notifikasi (pilihan)"
          }
        }
      }
    },
    "解析 TNG 通知正文。已识别付款记为消费，转账和未知通知单独保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parse TNG notification body. Recognized payments become expenses; transfers and unknown notices are stored separately."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurai teks notifikasi TNG. Bayaran dikenal pasti menjadi belanja; pindahan dan notifikasi lain disimpan berasingan."
          }
        }
      }
    },
    "TNG 通知已处理，请在月记查看结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TNG notification processed. Check YueJi for the result."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi TNG diproses. Semak hasil dalam YueJi."
          }
        }
      }
    },
    "记录银行与 TNG 通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record bank and TNG notification"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod notifikasi bank dan TNG"
          }
        }
      }
    },
    "银行与 TNG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banks and TNG"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank dan TNG"
          }
        }
      }
    },
    "记录成功付款，默认使用本次自动化运行的时刻。补录旧交易才开启使用指定交易时间；不会读取钱包历史。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record successful payments using the current automation time by default. Enable the specified transaction time only for older entries. Wallet history is not read."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod bayaran berjaya menggunakan masa automasi semasa secara lalai. Aktifkan masa transaksi ditetapkan hanya untuk rekod lama. Sejarah Wallet tidak dibaca."
          }
        }
      }
    },
    "交易描述（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction description (optional)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerangan transaksi (pilihan)"
          }
        }
      }
    },
    "指定交易时间（补录时使用）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specified transaction time (for older entries)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa transaksi ditetapkan (untuk rekod lama)"
          }
        }
      }
    },
    "使用指定交易时间（补录旧交易）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use specified transaction time (older entries)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan masa transaksi ditetapkan (rekod lama)"
          }
        }
      }
    },
    "疑似重复，已保留待确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible duplicate kept for review."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemungkinan pendua disimpan untuk semakan."
          }
        }
      }
    },
    "这笔付款已处理，没有重复入账。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This payment was already processed. No duplicate was added."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayaran ini telah diproses. Tiada pendua ditambah."
          }
        }
      }
    },
    "接收任意银行与 TNG 通知。明确的马币付款自动记账；转账、收款及无法确认的格式待确认，广告及验证码忽略。来源 App 名称可用于区分银行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive bank and TNG notifications. Clear MYR payments are recorded automatically. Transfers, receipts and uncertain formats need review; ads and verification codes are ignored. The source app name can identify the bank."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima notifikasi bank dan TNG. Bayaran MYR yang jelas direkod secara automatik. Pindahan, penerimaan dan format tidak pasti perlu semakan; iklan dan kod pengesahan diabaikan. Nama app sumber boleh mengenal pasti bank."
          }
        }
      }
    },
    "来源 App 名称（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source app name (optional)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama app sumber (pilihan)"
          }
        }
      }
    }
  },
  "version": "1.0"
}
