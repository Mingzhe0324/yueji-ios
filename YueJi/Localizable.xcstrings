        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Apple Pay expense"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod belanja Apple Pay"
          }
        }
      }
    },
    "记录 Apple Pay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Apple Pay"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod Apple Pay"
          }
        }
      }
    },
